{
  "name": "ach-lsp",
  "displayName": "ACH",
  "description": "Language server and editing support for NACHA ACH files",
  "version": "0.1.0",
  "publisher": "christopherdavenport", 
  "icon": "icon.png", 
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/christopherdavenport/ach-lsp"
  },
  "homepage": "https://github.com/christopherdavenport/ach-lsp#readme",
  "bugs": {
    "url": "https://github.com/christopherdavenport/ach-lsp/issues"
  },
  "engines": {
    "vscode": "^1.85.0"
  },
  "categories": [
    "Programming Languages",
    "Linters",
    "Formatters"
  ],
  "keywords": [
    "ach",
    "nacha",
    "banking",
    "payments",
    "eft"
  ],
  "activationEvents": [
    "onLanguage:ach",
    "onView:achExplorer"
  ],
  "main": "./client/out/extension.js",
  "contributes": {
    "languages": [
      {
        "id": "ach",
        "aliases": [
          "ACH",
          "NACHA"
        ],
        "extensions": [
          ".ach"
        ],
        "firstLine": "^101",
        "configuration": "./language-configuration.json"
      }
    ],
    "grammars": [
      {
        "language": "ach",
        "scopeName": "source.ach",
        "path": "./syntaxes/ach.tmLanguage.json"
      }
    ],
    "configuration": {
      "type": "object",
      "title": "ACH",
      "properties": {
        "ach.maxNumberOfProblems": {
          "order": 1,
          "scope": "resource",
          "type": "number",
          "default": 1000,
          "description": "Controls the maximum number of problems produced by the server."
        },
        "ach.trace.server": {
          "order": 2,
          "scope": "window",
          "type": "string",
          "enum": [
            "off",
            "messages",
            "verbose"
          ],
          "enumDescriptions": [
            "No tracing.",
            "Trace request/response messages.",
            "Trace full message content including parameters."
          ],
          "default": "off",
          "description": "Traces the communication between VS Code and the ACH language server."
        },
        "ach.validation.skipAll": {
          "order": 10,
          "scope": "resource",
          "type": "boolean",
          "default": false,
          "markdownDescription": "Disable all validation. When enabled, no `ach-ts` validation rules are applied."
        },
        "ach.validation.allowZeroBatches": {
          "order": 11,
          "scope": "resource",
          "type": "boolean",
          "default": false,
          "description": "Allow files with no batches."
        },
        "ach.validation.customTraceNumbers": {
          "order": 12,
          "scope": "resource",
          "type": "boolean",
          "default": false,
          "description": "Allow trace numbers that don't match ODFI."
        },
        "ach.validation.requireABAOrigin": {
          "order": 13,
          "scope": "resource",
          "type": "boolean",
          "default": false,
          "description": "Require valid ABA routing number as origin."
        },
        "ach.validation.bypassOriginValidation": {
          "order": 14,
          "scope": "resource",
          "type": "boolean",
          "default": false,
          "description": "Skip origin field validation."
        },
        "ach.validation.bypassDestinationValidation": {
          "order": 15,
          "scope": "resource",
          "type": "boolean",
          "default": false,
          "description": "Skip destination field validation."
        },
        "ach.validation.allowMissingFileHeader": {
          "order": 16,
          "scope": "resource",
          "type": "boolean",
          "default": false,
          "description": "Allow files without a FileHeader record."
        },
        "ach.validation.allowMissingFileControl": {
          "order": 17,
          "scope": "resource",
          "type": "boolean",
          "default": false,
          "description": "Allow files without a FileControl record."
        },
        "ach.validation.bypassCompanyIdentificationMatch": {
          "order": 18,
          "scope": "resource",
          "type": "boolean",
          "default": false,
          "description": "Skip batch header/control company ID match."
        },
        "ach.validation.customReturnCodes": {
          "order": 19,
          "scope": "resource",
          "type": "boolean",
          "default": false,
          "description": "Allow non-standard return codes in Addenda99."
        },
        "ach.validation.unequalServiceClassCode": {
          "order": 20,
          "scope": "resource",
          "type": "boolean",
          "default": false,
          "description": "Allow mismatched service class codes."
        },
        "ach.validation.allowUnorderedBatchNumbers": {
          "order": 21,
          "scope": "resource",
          "type": "boolean",
          "default": false,
          "description": "Allow non-ascending batch numbers."
        },
        "ach.validation.allowInvalidCheckDigit": {
          "order": 22,
          "scope": "resource",
          "type": "boolean",
          "default": false,
          "description": "Skip routing number check digit validation."
        },
        "ach.validation.unequalAddendaCounts": {
          "order": 23,
          "scope": "resource",
          "type": "boolean",
          "default": false,
          "description": "Allow addenda count mismatches."
        },
        "ach.validation.preserveSpaces": {
          "order": 24,
          "scope": "resource",
          "type": "boolean",
          "default": false,
          "description": "Retain trailing whitespace during parsing."
        },
        "ach.validation.allowInvalidAmounts": {
          "order": 25,
          "scope": "resource",
          "type": "boolean",
          "default": false,
          "description": "Allow malformed amount fields."
        },
        "ach.validation.allowZeroEntryAmount": {
          "order": 26,
          "scope": "resource",
          "type": "boolean",
          "default": false,
          "description": "Allow entries with zero dollar amounts."
        },
        "ach.validation.allowSpecialCharacters": {
          "order": 27,
          "scope": "resource",
          "type": "boolean",
          "default": false,
          "description": "Allow non-alphanumeric characters in fields."
        },
        "ach.validation.allowEmptyIndividualName": {
          "order": 28,
          "scope": "resource",
          "type": "boolean",
          "default": false,
          "description": "Allow blank individual name fields."
        },
        "ach.validation.bypassBatchValidation": {
          "order": 29,
          "scope": "resource",
          "type": "boolean",
          "default": false,
          "markdownDescription": "Skip all batch-level validation. Disables balance checks, count verification, and control record matching."
        },
        "ach.validation.skipFileCreationValidation": {
          "order": 30,
          "scope": "resource",
          "type": "boolean",
          "default": false,
          "description": "Skip file creation date validation."
        },
        "ach.validation.skipBatchHeaderCompanyValidation": {
          "order": 31,
          "scope": "resource",
          "type": "boolean",
          "default": false,
          "description": "Skip company name/ID validation in batch headers."
        },
        "ach.fieldSeparators": {
          "order": 3,
          "scope": "resource",
          "type": "boolean",
          "default": true,
          "description": "Show visual separators between fields in the editor."
        },
        "ach.autoOpenPreview": {
          "order": 4,
          "scope": "window",
          "type": "boolean",
          "default": true,
          "description": "Automatically open the ACH Preview panel when opening an ACH file."
        }
      }
    },
    "views": {
      "explorer": [
        {
          "icon": "$(file-code)",
          "id": "achExplorer",
          "name": "ACH Explorer",
          "contextualTitle": "ACH",
          "when": "resourceLangId == ach"
        }
      ]
    },
    "commands": [
      {
        "command": "ach.openPreview",
        "title": "Open Preview",
        "category": "ACH",
        "icon": "$(open-preview-to-side)",
        "enablement": "resourceLangId == ach"
      },
      {
        "command": "ach.toggleInlayHints",
        "title": "Toggle Inlay Hints",
        "category": "ACH",
        "enablement": "editorLangId == ach"
      },
      {
        "command": "ach.cursorFieldRight",
        "title": "Move Cursor to Next Field",
        "category": "ACH",
        "enablement": "editorLangId == ach"
      },
      {
        "command": "ach.cursorFieldLeft",
        "title": "Move Cursor to Previous Field",
        "category": "ACH",
        "enablement": "editorLangId == ach"
      },
      {
        "command": "ach.cursorFieldRightSelect",
        "title": "Select to Next Field",
        "category": "ACH",
        "enablement": "editorLangId == ach"
      },
      {
        "command": "ach.cursorFieldLeftSelect",
        "title": "Select to Previous Field",
        "category": "ACH",
        "enablement": "editorLangId == ach"
      },
      {
        "command": "ach.cursorSectionDown",
        "title": "Move to Next Section",
        "category": "ACH",
        "enablement": "editorLangId == ach"
      },
      {
        "command": "ach.cursorSectionUp",
        "title": "Move to Previous Section",
        "category": "ACH",
        "enablement": "editorLangId == ach"
      },
      {
        "command": "ach.cursorSectionDownSelect",
        "title": "Select to Next Section",
        "category": "ACH",
        "enablement": "editorLangId == ach"
      },
      {
        "command": "ach.cursorSectionUpSelect",
        "title": "Select to Previous Section",
        "category": "ACH",
        "enablement": "editorLangId == ach"
      },
      {
        "command": "ach.selectField",
        "title": "Select Field",
        "category": "ACH",
        "enablement": "editorLangId == ach"
      },
      {
        "command": "ach.copyFieldValue",
        "title": "Copy Field Value",
        "category": "ACH",
        "enablement": "editorLangId == ach"
      },
      {
        "command": "ach.toggleFieldSeparators",
        "title": "Toggle Field Separators",
        "category": "ACH",
        "icon": "$(symbol-number)",
        "enablement": "editorLangId == ach"
      }
    ],
    "menus": {
      "editor/title": [
        {
          "command": "ach.openPreview",
          "when": "resourceLangId == ach",
          "group": "navigation"
        },
        {
          "command": "ach.toggleFieldSeparators",
          "when": "resourceLangId == ach",
          "group": "navigation"
        },
        {
          "command": "ach.toggleInlayHints",
          "when": "resourceLangId == ach",
          "group": "1_ach"
        }
      ],
      "editor/context": [
        {
          "command": "ach.selectField",
          "when": "editorLangId == ach",
          "group": "ach@1"
        },
        {
          "command": "ach.copyFieldValue",
          "when": "editorLangId == ach",
          "group": "ach@2"
        }
      ]
    },
    "keybindings": [
      {
        "command": "ach.openPreview",
        "key": "ctrl+shift+v",
        "mac": "cmd+shift+v",
        "when": "resourceLangId == ach"
      },
      {
        "command": "ach.cursorFieldRight",
        "key": "ctrl+right",
        "mac": "alt+right",
        "when": "editorLangId == ach && editorTextFocus"
      },
      {
        "command": "ach.cursorFieldLeft",
        "key": "ctrl+left",
        "mac": "alt+left",
        "when": "editorLangId == ach && editorTextFocus"
      },
      {
        "command": "ach.cursorFieldRightSelect",
        "key": "ctrl+shift+right",
        "mac": "alt+shift+right",
        "when": "editorLangId == ach && editorTextFocus"
      },
      {
        "command": "ach.cursorFieldLeftSelect",
        "key": "ctrl+shift+left",
        "mac": "alt+shift+left",
        "when": "editorLangId == ach && editorTextFocus"
      },
      {
        "command": "ach.cursorSectionDown",
        "key": "ctrl+down",
        "mac": "alt+down",
        "when": "editorLangId == ach && editorTextFocus"
      },
      {
        "command": "ach.cursorSectionUp",
        "key": "ctrl+up",
        "mac": "alt+up",
        "when": "editorLangId == ach && editorTextFocus"
      },
      {
        "command": "ach.cursorSectionDownSelect",
        "key": "ctrl+shift+down",
        "mac": "alt+shift+down",
        "when": "editorLangId == ach && editorTextFocus"
      },
      {
        "command": "ach.cursorSectionUpSelect",
        "key": "ctrl+shift+up",
        "mac": "alt+shift+up",
        "when": "editorLangId == ach && editorTextFocus"
      },
      {
        "command": "ach.toggleInlayHints",
        "key": "ctrl+alt+h",
        "mac": "cmd+alt+h",
        "when": "editorLangId == ach && editorTextFocus"
      }
    ],
    "configurationDefaults": {
      "[ach]": {
        "editor.inlayHints.enabled": "on",
        "editor.rulers": [94],
        "editor.stickyScroll.enabled": true,
        "editor.stickyScroll.defaultModel": "outlineModel"
      },
      "editor.tokenColorCustomizations": {
        "textMateRules": [
          {
            "scope": "comment.line.padding.ach",
            "settings": {
              "foreground": "#80808050",
              "fontStyle": ""
            }
          }
        ]
      }
    },
    "snippets": [
      {
        "language": "ach",
        "path": "./snippets/ach.json"
      }
    ],
    "walkthroughs": [
      {
        "id": "ach.gettingStarted",
        "title": "Getting Started with ACH",
        "description": "Learn how to work with ACH/NACHA files in VS Code.",
        "steps": [
          {
            "id": "openFile",
            "title": "Open an ACH File",
            "description": "Open any `.ach` file to activate syntax highlighting, diagnostics, and the ACH Explorer.\n\n[Open a File](command:workbench.action.files.openFile)",
            "media": {
              "altText": "Open an ACH file",
              "markdown": "walkthroughs/open-file.md"
            }
          },
          {
            "id": "exploreStructure",
            "title": "Explore File Structure",
            "description": "Use the **ACH Explorer** panel in the sidebar to see the hierarchical structure of your file — batches, entries, and addenda records.\n\n[Show ACH Explorer](command:achExplorer.focus)",
            "media": {
              "altText": "ACH Explorer tree view",
              "markdown": "walkthroughs/explore-structure.md"
            }
          },
          {
            "id": "navigateFields",
            "title": "Navigate Between Fields",
            "description": "Use `Ctrl+Right` / `Ctrl+Left` to jump between fields, and `Ctrl+Down` / `Ctrl+Up` to jump between sections.\n\nHover over any field to see its name, description, and column range.",
            "media": {
              "altText": "Field navigation",
              "markdown": "walkthroughs/navigate-fields.md"
            }
          },
          {
            "id": "openPreview",
            "title": "Open the Preview Panel",
            "description": "View a structured, human-readable representation of your ACH file with field labels and values.\n\n[Open Preview](command:ach.openPreview)",
            "media": {
              "altText": "ACH Preview panel",
              "markdown": "walkthroughs/open-preview.md"
            }
          },
          {
            "id": "configureValidation",
            "title": "Configure Validation",
            "description": "Customize which validation rules to apply. Search for `ach.validation` in Settings to toggle individual checks.\n\n[Open Settings](command:workbench.action.openSettings?%22ach.validation%22)",
            "media": {
              "altText": "Validation settings",
              "markdown": "walkthroughs/configure-validation.md"
            }
          }
        ]
      }
    ]
  },
  "scripts": {
    "vscode:prepublish": "npm run compile",
    "compile": "node esbuild.mjs",
    "watch": "node esbuild.mjs --watch",
    "lint": "eslint ./client/src ./server/src --ext .ts",
    "postinstall": "cd client && npm install && cd ../server && npm install",
    "test": "cd server && npm test",
    "package": "npx @vscode/vsce package"
  },
  "devDependencies": {
    "esbuild": "^0.21.0",
    "@types/node": "^20.0.0",
    "typescript": "^5.5.0"
  }
}
