.vscode/**
.vscode-test/**
.github/**

# Everything is bundled by esbuild into client/out and server/out,
# so no package's node_modules or sources need to ship.
# NOTE: do not add a `!**/*.d.ts` negation here — it re-includes the
# entire node_modules tree and inflates the VSIX by ~4.5 MB.
**/node_modules/**
**/src/**
**/*.ts
**/*.map
**/tsconfig.json
**/tsconfig.tsbuildinfo
**/package-lock.json

# Docs site is not part of the extension bundle.
site/**
images/**

esbuild.mjs
.gitignore
AGENTS.md
**/*.vsix
